{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "commitMessageExtra": "{{#if currentVersion}}from {{currentVersion}} {{/if}}to {{#if isSingleVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}",
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([\\w-]*)requirements(-dev)?\\.(txt|pip)$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Lambda Python image tag in scripts/Dockerfile.build",
      "managerFilePatterns": [
        "/^scripts/Dockerfile\\.build$/"
      ],
      "matchStrings": [
        "FROM (?<depName>public\\.ecr\\.aws/lambda/python):(?<currentValue>[^-\\s]+)-\\$\\{ARCH\\}"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^3\\.14\\.(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d{2})\\.\\d{2}$"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}